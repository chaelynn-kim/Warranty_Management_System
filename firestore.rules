rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSeahUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@seah\\.co\\.kr$');
    }

    match /app-data/{docId} {
      allow read, write: if isSeahUser();
    }

    // 사용자 활동 이력 (추가·조회·삭제만, 수정 불가)
    match /activity-logs/{logId} {
      allow read, create, delete: if isSeahUser();
      allow update: if false;
    }
  }
}
